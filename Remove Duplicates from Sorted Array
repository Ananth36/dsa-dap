class Solution {
public:
    int removeDuplicates(vector<int>& nums) {
        int j = 0;
        int l = 0;
        for(int i = 1;i<nums.size();i++){
            if(nums[j]!=nums[i]){
                nums[j+1] = nums[i];
                j++;
                l+=1;
            }
        }
        return l+1;
    }
};


class Solution {
    public int removeDuplicates(int[] nums) {
        int j = 0;
        int l = 0;
        for(int i =0;i<nums.length;i++){
            if(nums[i]!=nums[j]){
                j++;
                nums[j] = nums[i];
                l++;
            }
        }
        return l+1;
    }
}


class Solution(object):
    def removeDuplicates(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        if len(nums)<=1:
            return len(nums)
        lst = []
        for i in nums:
            if i not in lst:
                lst+=[i]

        for i in range(len(lst)):
            nums[i] =lst[i]
        return len(lst)
