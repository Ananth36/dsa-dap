def countSort(arr):
    m = min(arr)
    count = [0]*(max(arr)-m+1)
    for i in arr:
        count[i-m]+=1
    for i in range(1,len(count)):
        count[i] += count[i-1]
    for i in range(len(count)-1,0,-1):
        count[i] = count[i-1]
    count[0] = 0

    res = [0]*len(arr)
    for i in range(len(res)):
        res[count[arr[i]-m]] = arr[i]
        count[arr[i]-m] +=1
    return res

print(countSort([5,5,5,4,2,1,6,7,3]))


  //java
  
import java.util.Arrays;


public class Main{

    static int[] countingSort(int[] arr){
        int min = arr[0],max = arr[0];
        for(int i:arr){
            if(i>max)max = i;
            if(i<min)min = i;
        }
        int[] count = new int[max-min+1];
        for(int i:arr){count[i-min]++;}
        for(int i = 1;i<count.length;i++){
            count[i]+=count[i-1];
        }
        for(int i = count.length-1;i>0;i--){
            count[i] = count[i-1];
        }
        count[0] = 0;
        int[] res = new int[arr.length];
        for(int i:arr){
            res[count[i-min]] = i;
            count[i-min]+=1;
        }
        return res;
    }
    public static void main(String[] args){
        int [] arr = {1,1,1,1,2,3,4,2};
        int[] res = countingSort(arr);
        System.out.println(Arrays.toString(res));
    }
}

