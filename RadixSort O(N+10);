vector<int> radixSort(vector<int> arr){
    int mx = *max_element(arr.begin(),arr.end());
    int ex = 0;

    while((mx/pow(10,ex))>=1){
        vector<int>digits(arr.size());
        for(int i = 0;i<arr.size();i++){
            int degree = (int)(arr[i]/(pow(10,ex)));
            int digit = degree%10;
            digits[i] = digit;
        }
        int max = *max_element(digits.begin(),digits.end());
        int min = *min_element(digits.begin(),digits.end());
        vector<int> count(max-min+1);
        for(int i:digits){
            count[i-min] +=1;
        }
        for(int i = 1;i<count.size();i++){
            count[i] += count[i-1];
        }
        for(int i =count.size()-1;i>0;i--){
            count[i] = count[i-1];
        }
        count[0] = 0;
        vector<int> res(arr.size());
        for(int i = 0;i<arr.size();i++){
            res[count[digits[i]-min]] = arr[i];
            count[digits[i]-min]+=1;
        }
        arr = res;
        ex+=1;
    }

    return arr;
}

