class Solution:
    def removeDuplicates(self, nums: List[int]) -> int:
        j = 0
        res = []

        
        for i in range(len(nums)):
            if nums[i] == nums[j] and i-j<=1:
                res.append(nums[i])
            elif nums[i] !=nums[j]:
                res.append(nums[i])
                j = i
        for i in range(len(res)):
            nums[i] = res[i]

        return len(res)



