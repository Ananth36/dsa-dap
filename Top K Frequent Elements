class Solution {
public:
    vector<int> topKFrequent(vector<int>& nums, int k) {
        priority_queue<
        pair<int,int>,
        vector<pair<int,int>>,
        greater<pair<int,int>>
        >pq;

        unordered_map<int,int> freq;
        for(int i:nums){
            if(freq.find(i)!=freq.end()){
                freq[i]+=1;
            }
            else{
                freq[i] = 1;
            }
        }
        for(auto &i: freq){
            pq.push({i.second,i.first});
            if(pq.size()>k){
                pq.pop();
            }
        }
        vector<int> res;
        while(!pq.empty()){
            res.push_back(pq.top().second);
            pq.pop();
        }
        return res;
    }
};
