class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        double max = 0;
        double cur = 0;
        for(int i = 0;i<k;i++){
            cur+=nums[i];
        }
        max =cur;
        for(int i = k;i<nums.size();i++){
            cur = cur+nums[i]-nums[i-k];
            if(cur>max){
                max = cur;
            }
        }
        return max/k;
    }
};

class Solution(object):
    def findMaxAverage(self, nums, k):
        """
        :type nums: List[int]
        :type k: int
        :rtype: float
        """
        max = sum(nums[:k])
        cur = float(max)
        for i in range(k,len(nums)):
            cur += nums[i]-nums[i-k]
            if cur>max:
                max = cur
        return float(max)/float(k)

class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int max = 0;
        int cur = 0;
        for(int i =0;i<k;i++){
            max+=nums[i];
        }
        cur = max;
        for(int i = k;i<nums.length;i++){
            cur +=nums[i]-nums[i-k];
            if(max<cur){max = cur;}
        }
        return (double)max/(double)k;
    }
}
