//java
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.lang.Math;
public class Main{
    public static int max(int[] arr){
        int x = arr[0];
        for(int i:arr){
            if(x<i){x = i;}
        }
        return x;
    }
    public static int min(int[] arr){
        int x = arr[0];
        for(int i:arr){
            if(x>i){x = i;}
        }
        return x;
    }

    static int[] radixSort(int[] arr){
        int ex = 0;
        int ul = max(arr);

        while(ul/Math.pow(10,ex) >= 1){
            int[] digits = new int[arr.length];
            for(int i = 0;i<arr.length;i++){
                int digit =(int)(arr[i]/Math.pow(10,ex)) % 10;
                digits[i] = digit;
            }
            int mn = min(digits);
            int[] count = new int[max(digits)-mn+1];
            Arrays.fill(count,0);
            for(int i = 0;i<arr.length;i++){
                count[digits[i]-mn]+=1;
            }
            for(int i = 1;i<count.length;i++){
                count[i] +=count[i-1];
            }
            for(int i = count.length-1;i>0;i--){
                count[i] = count[i-1];
            }

            count[0] = 0;
            int[] res = new int[arr.length];
            for(int i = 0;i<res.length;i++){
                res[count[digits[i]-mn]] = arr[i];
                count[digits[i]-mn]+=1;
            }
            arr= res;
            ex++;
        }

        return arr;
    }
    public static void main(String[] args){
        int [] arr = {123,1211,232,41223,23};
        int[] res = radixSort(arr);
        System.out.println(Arrays.toString(res));

    }
}

