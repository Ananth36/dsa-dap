class Solution {
public:
    string srted(string s){
        sort(s.begin(),s.end());
        return s;
    }
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        unordered_map<string,vector<string>> rec;
        for(int i = 0;i<strs.size();i++){
            string s = srted(strs[i]);
            if(rec.find(s)!=rec.end()){
                rec[s].push_back(strs[i]);
            }
            else{
                vector<string> a;
                a.push_back(strs[i]);
                rec[s] = a;
            }
        }
        vector<vector<string>> res;
        for(auto &i: rec){
            res.push_back(i.second);
        }
        return res;

    }
};


import java.util.*;

class Solution {

    public String srt(String s) {
        char[] arr = s.toCharArray();
        Arrays.sort(arr);
        return new String(arr);
    }

    public List<List<String>> groupAnagrams(String[] strs) {

        HashMap<String, List<String>> rec = new HashMap<>();

        for (int i = 0; i < strs.length; i++) {
            String srr = srt(strs[i]);

            if (rec.containsKey(srr)) {
                rec.get(srr).add(strs[i]);
            } else {
                List<String> arr = new ArrayList<>();
                arr.add(strs[i]);
                rec.put(srr, arr);
            }
        }

        return new ArrayList<>(rec.values());
    }
}

class Solution(object):
    def groupAnagrams(self, strs):
        """
        :type strs: List[str]
        :rtype: List[List[str]]
        """
        d = {}
        for i in strs:
            r = ''.join(sorted([j for j in i]))
            if r not in d.keys():
                d[r] =[i]
            else:
                d[r].append(i)
        return d.values()
