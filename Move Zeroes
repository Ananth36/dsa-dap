class Solution {
    public void moveZeroes(int[] nums) {
        int b = 0;
        int n = nums.length;
        for(int f = 0;f < n;f++){
            if(nums[f]!=0){
                int r = nums[b];
                nums[b] = nums[f];
                nums[f] = r;
                b+=1;
            }
        }
    }

}

class Solution(object):
    def moveZeroes(self, nums):
        """
        :type nums: List[int]
        :rtype: None Do not return anything, modify nums in-place instead.
        """
        i = 0
        for j in range(len(nums)):
            if nums[j]!=0:
                nums[j],nums[i] = nums[i],nums[j]
