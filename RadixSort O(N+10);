def radixSort(arr):
   mx = max(arr)
   ex = 0

   while mx // (10**ex) >0:
       digits = [(i//(10**(ex)))%(10) for i in arr]
       mn = min(digits)
       count = [0]*(max(digits)-mn+1)
       for i in digits:
           count[i-mn]+=1
       for i in range(1,len(count)):
           count[i] += count[i-1]
       for i in range(len(count)-1,0,-1):
           count[i] = count[i-1]
       count[0] = 0
       res = [0]*len(digits)
       for i in range(len(digits)):
           res[count[digits[i]-mn]] = arr[i]
           count[digits[i]-mn]+=1
       ex+=1
       arr = res
   return arr

